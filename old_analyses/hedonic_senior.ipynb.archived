   ],
   "source": [
    "import requests\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "import statsmodels.api as sm\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import os\n",
    "from scipy import stats\n",
    "\n",
    "# --- PUBLICATION READY VARIABLE MAP ---\n",
    "VAR_MAP = {\n",
    "    # Target\n",
    "    'change_65plus_pct': r'$\\Delta$ Pop. 65+ Share (2000-2010)',\n",
    "    \n",
    "    # The Pipeline\n",
    "    'pct_55_64_2000': 'Pop. 55-64 Share (2000)',\n",
    "    \n",
    "    # Anchors & Accelerators\n",
    "    'seasonal_housing_share_2000': 'Seasonal Housing Share',\n",
    "    'hispanic_share_2000': 'Hispanic Pop. Share',\n",
    "    'private_school_share_2000': 'Private School Market Share',\n",
    "    \n",
    "    # Controls\n",
    "    'pct_65plus_2000': 'Baseline Pop. 65+ Share (2000)',\n",
    "    'log_pop_2000': 'Log Total Population',\n",
    "    'healthcare_share_2000': 'Healthcare Employment Share',\n",
    "    'manufacturing_share_2000': 'Manufacturing Employment Share',\n",
    "    'mining_share_2000': 'Mining Employment Share',\n",
    "    'college_enrollment_share_2000': 'College Enrollment Share',\n",
    "    \n",
    "    # Optionals\n",
    "    'median_hh_income_2000': r'Median HH Income (\\$000s)',\n",
    "    'median_house_value_2000': r'Median House Value (\\$0000s)',\n",
    "    'Scale': 'Natural Amenities Scale',\n",
    "    'state_income_tax_2000': 'State Income Tax Rate',\n",
    "    \n",
    "    # Dummies\n",
    "    'is_south': 'Region: South',\n",
    "    'is_west': 'Region: West',\n",
    "    'is_rural': 'Rural Indicator',\n",
    "    'is_metro': 'Metro Indicator',\n",
    "    'is_coastal': 'Coastal County',\n",
    "    \n",
    "    # Intercept\n",
    "    'const': 'Intercept'\n",
    "}\n",
    "\n",
    "OUTPUT_DIR = 'figures'\n",
    "\n",
    "class CountyDataCollector:\n",
    "    def __init__(self):\n",
    "        self.census_api_key = \"488b0df48f856b207eae540095aee8cd37926d3a\" \n",
    "        self.base_census_url = \"https://api.census.gov/data\"\n",
    "        \n",
    "    def get_census_data_2000_sf1(self):\n",
    "        print(\"Fetching 2000 SF1 Data (Demographics + Housing)...\")\n",
    "        url = f\"{self.base_census_url}/2000/dec/sf1\"\n",
    "        \n",
    "        vars_list = [\n",
    "            'NAME', 'P001001', 'P004003', 'H001001', 'H005005',\n",
    "            'P012017', 'P012018', 'P012019', # M 55-64\n",
    "            'P012041', 'P012042', 'P012043', # F 55-64\n",
    "            'P012020', 'P012021', 'P012022', 'P012023', 'P012024', 'P012025', # M 65+\n",
    "            'P012044', 'P012045', 'P012046', 'P012047', 'P012048', 'P012049'  # F 65+\n",
    "        ]\n",
    "        \n",
    "        params = {'get': \",\".join(vars_list), 'for': 'county:*', 'in': 'state:*', 'key': self.census_api_key}\n",
    "        \n",
    "        try:\n",
    "            r = requests.get(url, params=params)\n",
    "            r.raise_for_status()\n",
    "            df = pd.DataFrame(r.json()[1:], columns=r.json()[0])\n",
    "            \n",
    "            for c in df.columns.drop(['NAME', 'state', 'county']):\n",
    "                df[c] = pd.to_numeric(df[c], errors='coerce').fillna(0)\n",
    "            \n",
    "            df['total_pop_2000'] = df['P001001']\n",
    "            \n",
    "            df['pop_55_64_2000'] = (df['P012017'] + df['P012018'] + df['P012019'] + \n",
    "                                    df['P012041'] + df['P012042'] + df['P012043'])\n",
    "            \n",
    "            df['pop_65plus_2000'] = (df.loc[:, 'P012020':'P012025'].sum(axis=1) + \n",
    "                                     df.loc[:, 'P012044':'P012049'].sum(axis=1))\n",
    "            \n",
    "            df['pct_65plus_2000'] = np.where(df['total_pop_2000']>0, df['pop_65plus_2000']/df['total_pop_2000']*100, 0)\n",
    "            df['pct_55_64_2000'] = np.where(df['total_pop_2000']>0, df['pop_55_64_2000']/df['total_pop_2000']*100, 0)\n",
    "            df['hispanic_share_2000'] = np.where(df['total_pop_2000']>0, df['P004003']/df['total_pop_2000']*100, 0)\n",
    "            \n",
    "            df['seasonal_housing_share_2000'] = np.where(\n",
    "                df['H001001'] > 0, df['H005005'] / df['H001001'] * 100, 0\n",
    "            )\n",
    "            \n",
    "            df['fips'] = df['state'] + df['county']\n",
    "            return df[['fips', 'total_pop_2000', 'pop_65plus_2000', 'pct_65plus_2000', 'pct_55_64_2000', \n",
    "                       'hispanic_share_2000', 'seasonal_housing_share_2000']]\n",
    "        except Exception as e:\n",
    "            print(f\"Error in 2000 SF1: {e}\")\n",
    "            return None\n",
    "\n",
    "    def get_census_data_2000_sf3(self):\n",
    "        print(\"Fetching 2000 SF3 Data (School + Econ)...\")\n",
    "        url = f\"{self.base_census_url}/2000/dec/sf3\"\n",
    "        \n",
    "        # Original vars plus college enrollment vars from P036\n",
    "        # P036008: Male public college undergrad\n",
    "        # P036009: Male public grad/professional\n",
    "        # P036014: Male private college undergrad\n",
    "        # P036015: Male private grad/professional\n",
    "        # P036023: Female public college undergrad\n",
    "        # P036024: Female public grad/professional\n",
    "        # P036029: Female private college undergrad\n",
    "        # P036030: Female private grad/professional\n",
    "        vars_list = [\n",
    "            'P053001', 'H076001', 'P036003', 'P036027',\n",
    "            'P036005', 'P036009', 'P036013', 'P036017', 'P036021',\n",
    "            'P036029', 'P036033', 'P036037', 'P036041', 'P036045',\n",
    "            # College enrollment variables\n",
    "            'P036008', 'P036014', 'P036015',\n",
    "            'P036023', 'P036024', 'P036030'\n",
    "        ]\n",
    "        \n",
    "        params = {'get': \",\".join(vars_list), 'for': 'county:*', 'in': 'state:*', 'key': self.census_api_key}\n",
    "        \n",
    "        try:\n",
    "            r = requests.get(url, params=params)\n",
    "            r.raise_for_status()\n",
    "            df = pd.DataFrame(r.json()[1:], columns=r.json()[0])\n",
    "            \n",
    "            for c in df.columns.drop(['state', 'county']):\n",
    "                df[c] = pd.to_numeric(df[c], errors='coerce').fillna(0)\n",
    "            \n",
    "            df['total_students'] = df['P036003'] + df['P036027']\n",
    "            private = (df[['P036005', 'P036009', 'P036013', 'P036017', 'P036021']].sum(axis=1) + \n",
    "                       df[['P036029', 'P036033', 'P036037', 'P036041', 'P036045']].sum(axis=1))\n",
    "            \n",
    "            df['private_school_share_2000'] = np.where(\n",
    "                df['total_students'] > 0, (private / df['total_students']) * 100, 0\n",
    "            )\n",
    "            \n",
    "            # College enrollment: sum all college-level enrollment (undergrad + grad, public + private)\n",
    "            college_vars = ['P036008', 'P036009', 'P036014', 'P036015', \n",
    "                           'P036023', 'P036024', 'P036029', 'P036030']\n",
    "            # Only sum vars that exist in dataframe (API may not return all)\n",
    "            existing_college_vars = [v for v in college_vars if v in df.columns]\n",
    "            if existing_college_vars:\n",
    "                df['college_enrollment_2000'] = df[existing_college_vars].sum(axis=1)\n",
    "            else:\n",
    "                df['college_enrollment_2000'] = 0\n",
    "            \n",
    "            df['median_hh_income_2000'] = df['P053001'] / 1000\n",
    "            df['median_house_value_2000'] = df['H076001'] / 10000\n",
    "            \n",
    "            df['fips'] = df['state'] + df['county']\n",
    "            return df[['fips', 'median_hh_income_2000', 'median_house_value_2000', \n",
    "                       'private_school_share_2000', 'college_enrollment_2000']]\n",
    "        except Exception as e:\n",
    "            print(f\"Error in 2000 SF3: {e}\")\n",
    "            return None\n",
    "\n",
    "    def get_census_data_2010(self):\n",
    "        print(\"Fetching 2010 Census data...\")\n",
    "        url = f\"{self.base_census_url}/2010/dec/sf1\"\n",
    "        vars_list = ['P001001','P012020','P012021','P012022','P012023','P012024','P012025',\n",
    "                     'P012044','P012045','P012046','P012047','P012048','P012049']\n",
    "        \n",
    "        params = {'get': \",\".join(vars_list), 'for': 'county:*', 'in': 'state:*', 'key': self.census_api_key}\n",
    "        \n",
    "        try:\n",
    "            r = requests.get(url, params=params)\n",
    "            r.raise_for_status()\n",
    "            df = pd.DataFrame(r.json()[1:], columns=r.json()[0])\n",
    "            for c in df.columns.drop(['state', 'county']):\n",
    "                df[c] = pd.to_numeric(df[c], errors='coerce').fillna(0)\n",
    "            \n",
    "            pop_65plus = (df.loc[:, 'P012020':'P012025'].sum(axis=1) + \n",
    "                          df.loc[:, 'P012044':'P012049'].sum(axis=1))\n",
    "            \n",
    "            df['pct_65plus_2010'] = np.where(\n",
    "                df['P001001'] > 0, (pop_65plus / df['P001001']) * 100, 0\n",
    "            )\n",
    "            \n",
    "            # Keep total pop and 65+ pop for calculating population change\n",
    "            df['total_pop_2010'] = df['P001001']\n",
    "            df['pop_65plus_2010'] = pop_65plus\n",
    "            \n",
    "            df['fips'] = df['state'] + df['county']\n",
    "            return df[['fips', 'pct_65plus_2010', 'total_pop_2010', 'pop_65plus_2010']]\n",
    "        except Exception as e:\n",
    "            print(f\"Error in 2010 Data: {e}\")\n",
    "            return None\n",
    "\n",
    "    def get_cbp_2000_industries(self):\n",
    "        \"\"\"Pull healthcare, manufacturing, and mining shares from CBP 2000.\"\"\"\n",
    "        url = f\"{self.base_census_url}/2000/cbp\"\n",
    "        try:\n",
    "            # Total employment\n",
    "            r_tot = requests.get(url, params={'get': 'EMP', 'for': 'county:*', 'in': 'state:*', 'NAICS1997': '00', 'key': self.census_api_key})\n",
    "            # Healthcare (62)\n",
    "            r_hlth = requests.get(url, params={'get': 'EMP', 'for': 'county:*', 'in': 'state:*', 'NAICS1997': '62', 'key': self.census_api_key})\n",
    "            # Manufacturing (31-33, use 31 as prefix)\n",
    "            r_mfg = requests.get(url, params={'get': 'EMP', 'for': 'county:*', 'in': 'state:*', 'NAICS1997': '31', 'key': self.census_api_key})\n",
    "            # Mining (21)\n",
    "            r_mine = requests.get(url, params={'get': 'EMP', 'for': 'county:*', 'in': 'state:*', 'NAICS1997': '21', 'key': self.census_api_key})\n",
    "            \n",
    "            if r_tot.status_code == 200:\n",
    "                d_tot = pd.DataFrame(r_tot.json()[1:], columns=r_tot.json()[0])\n",
    "                d_tot['fips'] = d_tot['state'] + d_tot['county']\n",
    "                d_tot['tot_emp'] = pd.to_numeric(d_tot['EMP'], errors='coerce').fillna(0)\n",
    "                result = d_tot[['fips', 'tot_emp']].copy()\n",
    "                \n",
    "                # Healthcare\n",
    "                if r_hlth.status_code == 200:\n",
    "                    d = pd.DataFrame(r_hlth.json()[1:], columns=r_hlth.json()[0])\n",
    "                    d['fips'] = d['state'] + d['county']\n",
    "                    d['hlth_emp'] = pd.to_numeric(d['EMP'], errors='coerce').fillna(0)\n",
    "                    result = pd.merge(result, d[['fips', 'hlth_emp']], on='fips', how='left')\n",
    "                \n",
    "                # Manufacturing\n",
    "                if r_mfg.status_code == 200:\n",
    "                    d = pd.DataFrame(r_mfg.json()[1:], columns=r_mfg.json()[0])\n",
    "                    d['fips'] = d['state'] + d['county']\n",
    "                    d['mfg_emp'] = pd.to_numeric(d['EMP'], errors='coerce').fillna(0)\n",
    "                    result = pd.merge(result, d[['fips', 'mfg_emp']], on='fips', how='left')\n",
    "                \n",
    "                # Mining\n",
    "                if r_mine.status_code == 200:\n",
    "                    d = pd.DataFrame(r_mine.json()[1:], columns=r_mine.json()[0])\n",
    "                    d['fips'] = d['state'] + d['county']\n",
    "                    d['mine_emp'] = pd.to_numeric(d['EMP'], errors='coerce').fillna(0)\n",
    "                    result = pd.merge(result, d[['fips', 'mine_emp']], on='fips', how='left')\n",
    "                \n",
    "                result = result.fillna(0)\n",
    "                \n",
    "                # Calculate shares, handling missing columns\n",
    "                if 'hlth_emp' in result.columns:\n",
    "                    result['healthcare_share_2000'] = np.where(result['tot_emp'] > 0, result['hlth_emp'] / result['tot_emp'], 0)\n",
    "                else:\n",
    "                    result['healthcare_share_2000'] = 0\n",
    "                    \n",
    "                if 'mfg_emp' in result.columns:\n",
    "                    result['manufacturing_share_2000'] = np.where(result['tot_emp'] > 0, result['mfg_emp'] / result['tot_emp'], 0)\n",
    "                else:\n",
    "                    result['manufacturing_share_2000'] = 0\n",
    "                    \n",
    "                if 'mine_emp' in result.columns:\n",
    "                    result['mining_share_2000'] = np.where(result['tot_emp'] > 0, result['mine_emp'] / result['tot_emp'], 0)\n",
    "                else:\n",
    "                    result['mining_share_2000'] = 0\n",
    "                \n",
    "                return result[['fips', 'healthcare_share_2000', 'manufacturing_share_2000', 'mining_share_2000']]\n",
    "            return None\n",
    "        except Exception as e:\n",
    "            print(f\"Error in CBP: {e}\")\n",
    "            return None\n",
    "\n",
    "    def get_usda_amenities(self):\n",
    "        try:\n",
    "            df = pd.read_excel('amenities.xlsx')\n",
    "            df['fips'] = df['FIPS'].astype(str).str.zfill(5)\n",
    "            return df[['fips', 'Scale']]\n",
    "        except: return None\n",
    "\n",
    "    def get_state_tax_rates(self):\n",
    "        try:\n",
    "            df = pd.read_excel('tax.xlsx')\n",
    "            df['state_fips'] = df['FIPS'].astype(str).str.zfill(2)\n",
    "            df = df.rename(columns={'taxrate': 'state_income_tax_2000'})\n",
    "            return df[['state_fips', 'state_income_tax_2000']]\n",
    "        except: return None\n",
    "\n",
    "    def get_county_area(self):\n",
    "        try:\n",
    "            df = pd.read_csv('Counties_Area.csv')\n",
    "            col = 'GEOID' if 'GEOID' in df.columns else 'FIPS'\n",
    "            df['fips'] = df[col].astype(str).str.zfill(5)\n",
    "            df = df.rename(columns={'ALAND_SQMI': 'land_area_sqmi'})\n",
    "            return df[['fips', 'land_area_sqmi']]\n",
    "        except: return None\n",
    "\n",
    "    def get_coastal_counties(self):\n",
    "        \"\"\"\n",
    "        Load coastal county FIPS from external CSV.\n",
    "        Expected format: CSV with column 'fips' containing 5-digit FIPS codes.\n",
    "        \"\"\"\n",
    "        try:\n",
    "            df = pd.read_csv('coastal_fips.csv')\n",
    "            df['fips'] = df['fips'].astype(str).str.zfill(5)\n",
    "            coastal_set = set(df['fips'].tolist())\n",
    "            print(f\"Loaded {len(coastal_set)} coastal counties from coastal_fips.csv\")\n",
    "            return coastal_set\n",
    "        except FileNotFoundError:\n",
    "            print(\"WARNING: coastal_fips.csv not found.\")\n",
    "            print(\"Download NOAA shoreline counties from:\")\n",
    "            print(\"  https://coast.noaa.gov/data/digitalcoast/pdf/qrt-coastal-county-definitions.pdf\")\n",
    "            return None\n",
    "\n",
    "    def merge_all_data(self):\n",
    "        print(\"\\n--- MERGING DATASETS ---\")\n",
    "        df = self.get_census_data_2000_sf1()\n",
    "        if df is None: return None\n",
    "        \n",
    "        sf3 = self.get_census_data_2000_sf3()\n",
    "        if sf3 is not None: df = pd.merge(df, sf3, on='fips', how='left')\n",
    "        \n",
    "        c10 = self.get_census_data_2010()\n",
    "        if c10 is not None: df = pd.merge(df, c10, on='fips', how='inner')\n",
    "        else: return None\n",
    "        \n",
    "        df['change_65plus_pct'] = df['pct_65plus_2010'] - df['pct_65plus_2000']\n",
    "        \n",
    "        # Non-elderly population change 2000-2010 (percent)\n",
    "        # Using under-65 pop avoids mechanical correlation with outcome\n",
    "        df['pop_under65_2000'] = df['total_pop_2000'] - df['pop_65plus_2000']\n",
    "        df['pop_under65_2010'] = df['total_pop_2010'] - df['pop_65plus_2010']\n",
    "        df['pop_change_under65_pct'] = np.where(\n",
    "            df['pop_under65_2000'] > 0,\n",
    "            (df['pop_under65_2010'] - df['pop_under65_2000']) / df['pop_under65_2000'] * 100,\n",
    "            0\n",
    "        )\n",
    "        \n",
    "        # College enrollment share (as % of total pop)\n",
    "        if 'college_enrollment_2000' in df.columns:\n",
    "            df['college_enrollment_share_2000'] = np.where(\n",
    "                df['total_pop_2000'] > 0,\n",
    "                df['college_enrollment_2000'] / df['total_pop_2000'] * 100,\n",
    "                0\n",
    "            )\n",
    "        \n",
    "        for func in [self.get_cbp_2000_industries, self.get_usda_amenities, self.get_county_area]:\n",
    "            res = func()\n",
    "            if res is not None: df = pd.merge(df, res, on='fips', how='left')\n",
    "            \n",
    "        tax = self.get_state_tax_rates()\n",
    "        if tax is not None:\n",
    "            df['state_fips'] = df['fips'].str[:2]\n",
    "            df = pd.merge(df, tax, on='state_fips', how='left')\n",
    "            \n",
    "        df['log_pop_2000'] = np.log(df['total_pop_2000'].clip(lower=1))\n",
    "        \n",
    "        if 'land_area_sqmi' in df.columns:\n",
    "            df['pop_density'] = df['total_pop_2000'] / df['land_area_sqmi'].replace(0, 1)\n",
    "            df['is_rural'] = (df['pop_density'] < df['pop_density'].quantile(0.25)).astype(int)\n",
    "            df['is_metro'] = (df['pop_density'] > df['pop_density'].quantile(0.75)).astype(int)\n",
    "\n",
    "        df['is_south'] = df['fips'].str[:2].isin(['01','05','12','13','21','22','28','37','40','45','47','48','51','54']).astype(int)\n",
    "        df['is_west'] = df['fips'].str[:2].isin(['04','06','08','16','30','32','35','41','49','53','56']).astype(int)\n",
    "        \n",
    "        coastal_fips = self.get_coastal_counties()\n",
    "        if coastal_fips is not None:\n",
    "            df['is_coastal'] = df['fips'].isin(coastal_fips).astype(int)\n",
    "            print(f\"Coastal counties in dataset: {df['is_coastal'].sum()}\")\n",
    "        else:\n",
    "            df['is_coastal'] = 0\n",
    "\n",
    "        df = df.replace([np.inf, -np.inf], np.nan).dropna()\n",
    "        print(f\"Final Count: {len(df)} counties\")\n",
    "        return df\n",
    "\n",
    "    def run_regression(self, df):\n",
    "        print(\"\\n--- RUNNING REGRESSION ---\")\n",
    "        feature_cols = [\n",
    "            'pct_55_64_2000', 'seasonal_housing_share_2000', 'hispanic_share_2000',\n",
    "            'private_school_share_2000', 'pct_65plus_2000', 'log_pop_2000',\n",
    "            'is_south', 'is_west'\n",
    "        ]\n",
    "        \n",
    "        # Industry shares (from CBP)\n",
    "        for col in ['healthcare_share_2000', 'manufacturing_share_2000', 'mining_share_2000']:\n",
    "            if col in df.columns:\n",
    "                feature_cols.append(col)\n",
    "        \n",
    "        # Add college enrollment if available\n",
    "        if 'college_enrollment_share_2000' in df.columns:\n",
    "            feature_cols.append('college_enrollment_share_2000')\n",
    "        \n",
    "        if df['is_coastal'].sum() > 0:\n",
    "            feature_cols.append('is_coastal')\n",
    "        \n",
    "        for col in ['median_hh_income_2000', 'median_house_value_2000', 'Scale', 'state_income_tax_2000', 'is_rural', 'is_metro']:\n",
    "            if col in df.columns: feature_cols.append(col)\n",
    "        \n",
    "        # Remove zero-variance columns\n",
    "        feature_cols = [c for c in feature_cols if df[c].std() > 0]\n",
    "        print(f\"Features used: {feature_cols}\")\n",
    "        \n",
    "        X_raw = df[feature_cols]\n",
    "        y = df['change_65plus_pct']\n",
    "        \n",
    "        scaler = StandardScaler()\n",
    "        X_scaled = pd.DataFrame(scaler.fit_transform(X_raw), columns=X_raw.columns, index=X_raw.index)\n",
    "        X_sm = sm.add_constant(X_scaled)\n",
    "        \n",
    "        model = sm.OLS(y, X_sm).fit()\n",
    "        print(model.summary())\n",
    "        \n",
    "        return model, df, feature_cols\n",
    "\n",
    "    def generate_outputs(self, model, df, feature_cols):\n",
    "        print(f\"\\n--- GENERATING OUTPUTS TO {OUTPUT_DIR} ---\")\n",
    "        \n",
    "        if not os.path.exists(OUTPUT_DIR):\n",
    "            os.makedirs(OUTPUT_DIR)\n",
    "\n",
    "        sns.set_style(\"whitegrid\")\n",
    "        \n",
    "        # --- STATE-LEVEL RESIDUAL DIAGNOSTICS ---\n",
    "        df['residuals'] = model.resid\n",
    "        df['state_fips_2'] = df['fips'].str[:2]\n",
    "        \n",
    "        state_resid = df.groupby('state_fips_2').agg(\n",
    "            mean_resid=('residuals', 'mean'),\n",
    "            median_resid=('residuals', 'median'),\n",
    "            n_counties=('residuals', 'count')\n",
    "        ).reset_index()\n",
    "        \n",
    "        # State FIPS to name mapping (continental US)\n",
    "        state_names = {\n",
    "            '01': 'AL', '04': 'AZ', '05': 'AR', '06': 'CA', '08': 'CO', '09': 'CT',\n",
    "            '10': 'DE', '11': 'DC', '12': 'FL', '13': 'GA', '16': 'ID', '17': 'IL',\n",
    "            '18': 'IN', '19': 'IA', '20': 'KS', '21': 'KY', '22': 'LA', '23': 'ME',\n",
    "            '24': 'MD', '25': 'MA', '26': 'MI', '27': 'MN', '28': 'MS', '29': 'MO',\n",
    "            '30': 'MT', '31': 'NE', '32': 'NV', '33': 'NH', '34': 'NJ', '35': 'NM',\n",
    "            '36': 'NY', '37': 'NC', '38': 'ND', '39': 'OH', '40': 'OK', '41': 'OR',\n",
    "            '44': 'RI', '45': 'SC', '46': 'SD', '47': 'TN', '48': 'TX', '49': 'UT',\n",
    "            '50': 'VT', '51': 'VA', '53': 'WA', '54': 'WV', '55': 'WI', '56': 'WY'\n",
    "        }\n",
    "        state_resid['state'] = state_resid['state_fips_2'].map(state_names)\n",
    "        state_resid = state_resid.dropna(subset=['state'])\n",
    "        state_resid = state_resid.sort_values('mean_resid', ascending=False)\n",
    "        \n",
    "        print(\"\\n--- STATE-LEVEL RESIDUAL DIAGNOSTICS ---\")\n",
    "        print(\"Top 10 states (model UNDERPREDICTS elderly share growth):\")\n",
    "        print(state_resid.head(10)[['state', 'mean_resid', 'median_resid', 'n_counties']].to_string(index=False))\n",
    "        print(\"\\nBottom 10 states (model OVERPREDICTS elderly share growth):\")\n",
    "        print(state_resid.tail(10)[['state', 'mean_resid', 'median_resid', 'n_counties']].to_string(index=False))\n",
    "        \n",
    "        # Plot state residuals\n",
    "        plt.figure(figsize=(12, 6))\n",
    "        colors = ['#e74c3c' if x > 0 else '#3498db' for x in state_resid['mean_resid']]\n",
    "        plt.barh(state_resid['state'], state_resid['mean_resid'], color=colors)\n",
    "        plt.axvline(x=0, color='black', linewidth=0.8)\n",
    "        plt.xlabel('Mean Residual (pp)', fontsize=12)\n",
    "        plt.ylabel('State', fontsize=12)\n",
    "        plt.title('Mean Residuals by State\\n(Red = Underprediction, Blue = Overprediction)', fontsize=14)\n",
    "        plt.tight_layout()\n",
    "        plt.savefig(os.path.join(OUTPUT_DIR, 'residuals_by_state.png'), dpi=300, bbox_inches='tight')\n",
    "        plt.close()\n",
    "        print(\"Saved: residuals_by_state.png\")\n",
    "        \n",
    "        # Flag outlier states (mean resid > 1 SE of residuals)\n",
    "        resid_se = df['residuals'].std()\n",
    "        outlier_states = state_resid[state_resid['mean_resid'].abs() > resid_se]\n",
    "        if len(outlier_states) > 0:\n",
    "            print(f\"\\n⚠ OUTLIER STATES (|mean resid| > {resid_se:.2f}):\")\n",
    "            print(outlier_states[['state', 'mean_resid', 'n_counties']].to_string(index=False))\n",
    "            print(\"Consider: state fixed effects or state-specific controls\")\n",
    "        \n",
    "        for col in feature_cols:\n",
    "            # Skip columns with zero variance (can't regress)\n",
    "            if df[col].std() == 0:\n",
    "                print(f\"Skipping {col}: zero variance\")\n",
    "                continue\n",
    "                \n",
    "            plt.figure(figsize=(8, 6))\n",
    "            \n",
    "            nice_name = VAR_MAP.get(col, col)\n",
    "            y_name = VAR_MAP.get('change_65plus_pct', 'Change in 65+ Share')\n",
    "            \n",
    "            x_data = df[col].values\n",
    "            y_data = df['change_65plus_pct'].values\n",
    "            slope, intercept, r_value, p_value, std_err = stats.linregress(x_data, y_data)\n",
    "            r_squared = r_value ** 2\n",
    "            \n",
    "            sns.regplot(x=df[col], y=df['change_65plus_pct'], \n",
    "                        scatter_kws={'alpha':0.3, 's':10, 'color':'#2c3e50'}, \n",
    "                        line_kws={'color':'#e74c3c'})\n",
    "            \n",
    "            plt.xlabel(nice_name, fontsize=12)\n",
    "            plt.ylabel(y_name, fontsize=12)\n",
    "            plt.title(f\"{y_name} vs. {nice_name}\", fontsize=14)\n",
    "            \n",
    "            stats_text = (f\"$R^2$ = {r_squared:.3f}\\n\"\n",
    "                          f\"Slope = {slope:.4f}\\n\"\n",
    "                          f\"Intercept = {intercept:.3f}\\n\"\n",
    "                          f\"p-value = {p_value:.2e}\")\n",
    "            \n",
    "            if slope >= 0:\n",
    "                x_pos, y_pos, ha = 0.05, 0.95, 'left'\n",
    "            else:\n",
    "                x_pos, y_pos, ha = 0.95, 0.95, 'right'\n",
    "            \n",
    "            plt.gca().text(x_pos, y_pos, stats_text, transform=plt.gca().transAxes,\n",
    "                           fontsize=10, verticalalignment='top', horizontalalignment=ha,\n",
    "                           bbox=dict(boxstyle='round', facecolor='white', alpha=0.8, edgecolor='gray'))\n",
    "            \n",
    "            safe_fname = col.replace(\" \", \"_\").replace(\"/\", \"_\")\n",
    "            save_path = os.path.join(OUTPUT_DIR, f\"scatter_{safe_fname}.png\")\n",
    "            plt.savefig(save_path, dpi=300, bbox_inches='tight')\n",
    "            plt.close()\n",
    "            print(f\"Saved: scatter_{safe_fname}.png\")\n",
    "\n",
    "        print(\"\\n--- LATEX TABLE SOURCE ---\")\n",
    "        \n",
    "        results_df = pd.DataFrame({\n",
    "            'coef': model.params,\n",
    "            'std_err': model.bse,\n",
    "            'pvals': model.pvalues\n",
    "        })\n",
    "        \n",
    "        latex_str = r\"\"\"\\begin{table}[htbp]\n",
    "\\centering\n",
    "\\caption{Regression Results: Demographic Shift Drivers}\n",
    "\\label{tab:regression}\n",
    "\\begin{tabular}{lcc}\n",
    "\\hline\\hline\n",
    " & Coefficient & Std. Error \\\\\n",
    "\\hline\n",
    "\"\"\"\n",
    "        \n",
    "        if 'const' in results_df.index:\n",
    "            const_row = results_df.loc[['const']]\n",
    "            others = results_df.drop('const')\n",
    "            others = others.reindex(others['coef'].abs().sort_values(ascending=False).index)\n",
    "            results_df = pd.concat([others, const_row])\n",
    "        \n",
    "        for idx, row in results_df.iterrows():\n",
    "            var_name = VAR_MAP.get(idx, idx.replace(\"_\", \" \").title())\n",
    "            \n",
    "            if row['pvals'] < 0.01:\n",
    "                coef_str = f\"{row['coef']:.3f}$^{{***}}$\"\n",
    "            elif row['pvals'] < 0.05:\n",
    "                coef_str = f\"{row['coef']:.3f}$^{{**}}$\"\n",
    "            elif row['pvals'] < 0.1:\n",
    "                coef_str = f\"{row['coef']:.3f}$^{{*}}$\"\n",
    "            else:\n",
    "                coef_str = f\"{row['coef']:.3f}\"\n",
    "            \n",
    "            latex_str += f\"{var_name} & {coef_str} & ({row['std_err']:.3f}) \\\\\\\\\\n\"\n",
    "            \n",
    "        latex_str += \"\\\\hline\\n\"\n",
    "        latex_str += f\"Observations & {int(model.nobs)} & \\\\\\\\\\n\"\n",
    "        latex_str += f\"$R^2$ & {model.rsquared:.3f} & \\\\\\\\\\n\"\n",
    "        latex_str += r\"\"\"\\hline\\hline\n",
    "\\multicolumn{3}{l}{\\footnotesize $^{*}p<0.1$; $^{**}p<0.05$; $^{***}p<0.01$} \\\\\n",
    "\\end{tabular}\n",
    "\\end{table}\"\"\"\n",
    "        \n",
    "        print(latex_str)\n",
    "        \n",
    "        with open(os.path.join(OUTPUT_DIR, 'regression_table.tex'), 'w') as f:\n",
    "            f.write(latex_str)\n",
    "        print(\"Saved: regression_table.tex\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    c = CountyDataCollector()\n",
    "    df = c.merge_all_data()\n",
    "    if df is not None:\n",
    "        model, df_final, feats = c.run_regression(df)\n",
    "        c.generate_outputs(model, df_final, feats)"
   ]
  },
