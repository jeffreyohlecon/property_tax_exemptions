      "Saved: scatter_seasonal_housing_share_2000.png\n",
      "Saved: scatter_hispanic_share_2000.png\n",
      "Saved: scatter_private_school_share_2000.png\n",
      "Saved: scatter_pct_65plus_2000.png\n",
      "Saved: scatter_log_pop_2000.png\n",
      "Saved: scatter_is_south.png\n",
      "Saved: scatter_is_west.png\n",
      "Saved: scatter_healthcare_share_2000.png\n",
      "Saved: scatter_mining_share_2000.png\n",
      "Saved: scatter_college_enrollment_share_2000.png\n",
