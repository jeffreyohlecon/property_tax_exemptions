      "healthcare_share_2000            -0.0416      0.021     -2.015      0.044      -0.082      -0.001\n",
      "mining_share_2000                -0.1525      0.020     -7.720      0.000      -0.191      -0.114\n",
      "college_enrollment_share_2000    -0.0025      0.022     -0.114      0.909      -0.046       0.041\n",
      "is_coastal                        0.0430      0.021      2.008      0.045       0.001       0.085\n",
      "median_hh_income_2000             0.0347      0.033      1.040      0.299      -0.031       0.100\n",
      "median_house_value_2000           0.0185      0.033      0.559      0.576      -0.046       0.083\n",
      "Scale                            -0.0383      0.033     -1.175      0.240      -0.102       0.026\n",
      "state_income_tax_2000             0.0403      0.021      1.910      0.056      -0.001       0.082\n",
      "is_rural                          0.0604      0.028      2.137      0.033       0.005       0.116\n",
      "is_metro                         -0.0145      0.028     -0.516      0.606      -0.070       0.041\n",
      "==============================================================================\n",
      "Omnibus:                      750.978   Durbin-Watson:                   1.881\n",
