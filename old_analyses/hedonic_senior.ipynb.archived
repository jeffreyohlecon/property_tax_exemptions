   "source": [
    "import requests\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "import time\n",
    "\n",
    "class AdditionalDataCollector:\n",
    "    \"\"\"Collect data from non-Census government APIs\"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        # BLS API v2 (register for key at https://data.bls.gov/registrationEngine/)\n",
    "        self.bls_api_key = \"YOUR_BLS_API_KEY\"  # Optional but recommended\n",
    "        \n",
    "    def get_bls_unemployment_2000(self):\n",
    "        \"\"\"\n",
    "        Get unemployment rates from BLS Local Area Unemployment Statistics (LAUS)\n",
    "        Series ID format: LAUCN{FIPS}0000000003\n",
    "        \"\"\"\n",
    "        print(\"Fetching BLS unemployment data for 2000...\")\n",
    "        \n",
    "        # BLS API endpoint\n",
    "        url = \"https://api.bls.gov/publicAPI/v2/timeseries/data/\"\n",
    "        \n",
    "        # You'll need to batch these requests - BLS limits to 50 series per request\n",
    "        # This is a demonstration for a few counties\n",
    "        sample_fips = ['01001', '01003', '01005', '01007', '01009']  # Alabama counties\n",
    "        \n",
    "        series_ids = [f\"LAUCN{fips}0000000003\" for fips in sample_fips]\n",
    "        \n",
    "        headers = {'Content-type': 'application/json'}\n",
    "        data = json.dumps({\n",
    "            \"seriesid\": series_ids,\n",
    "            \"startyear\": \"2000\",\n",
    "            \"endyear\": \"2000\",\n",
    "            \"registrationkey\": self.bls_api_key\n",
    "        })\n",
    "        \n",
    "        try:\n",
    "            response = requests.post(url, data=data, headers=headers)\n",
    "            if response.status_code == 200:\n",
    "                json_data = response.json()\n",
    "                \n",
    "                if json_data['status'] == 'REQUEST_SUCCEEDED':\n",
    "                    results = []\n",
    "                    for series in json_data['Results']['series']:\n",
    "                        series_id = series['seriesID']\n",
    "                        fips = series_id[5:10]  # Extract FIPS from series ID\n",
    "                        \n",
    "                        # Get annual average\n",
    "                        values = [float(item['value']) for item in series['data'] \n",
    "                                 if item['year'] == '2000']\n",
    "                        if values:\n",
    "                            annual_avg = np.mean(values)\n",
    "                            results.append({\n",
    "                                'fips': fips,\n",
    "                                'bls_unemployment_rate_2000': annual_avg\n",
    "                            })\n",
    "                    \n",
    "                    return pd.DataFrame(results)\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error fetching BLS data: {e}\")\n",
    "        \n",
    "        return None\n",
    "    \n",
    "    def get_hrsa_health_professional_shortage_areas(self):\n",
    "        \"\"\"\n",
    "        Get Health Professional Shortage Area (HPSA) data from HRSA\n",
    "        This indicates healthcare access issues\n",
    "        \"\"\"\n",
    "        print(\"Fetching HRSA Health Professional Shortage Area data...\")\n",
    "        \n",
    "        # HRSA Data Warehouse API\n",
    "        url = \"https://data.hrsa.gov/api/v1/data\"\n",
    "        \n",
    "        # Query for primary care HPSAs by county\n",
    "        params = {\n",
    "            'tableName': 'HPSA_PrimaryCare',\n",
    "            'fields': 'StateCountyFIPSCode,HPSA_Score,HPSA_FTE_Short',\n",
    "            'filter': 'HPSA_Status eq \"Designated\"',\n",
    "            '$top': 5000  # Get many records\n",
    "        }\n",
    "        \n",
    "        try:\n",
    "            response = requests.get(url, params=params)\n",
    "            if response.status_code == 200:\n",
    "                data = response.json()\n",
    "                df = pd.DataFrame(data['value'])\n",
    "                \n",
    "                # Aggregate by county (some counties have multiple HPSAs)\n",
    "                county_agg = df.groupby('StateCountyFIPSCode').agg({\n",
    "                    'HPSA_Score': 'mean',  # Average shortage score\n",
    "                    'HPSA_FTE_Short': 'sum'  # Total provider shortage\n",
    "                }).reset_index()\n",
    "                \n",
    "                county_agg.columns = ['fips', 'avg_hpsa_score', 'total_provider_shortage']\n",
    "                \n",
    "                return county_agg\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error fetching HRSA data: {e}\")\n",
    "        \n",
    "        return None\n",
    "    \n",
    "    def get_cdc_health_rankings(self):\n",
    "        \"\"\"\n",
    "        Get county health rankings data from CDC PLACES\n",
    "        (Successor to County Health Rankings)\n",
    "        \"\"\"\n",
    "        print(\"Fetching CDC PLACES health data...\")\n",
    "        \n",
    "        # CDC PLACES API endpoint\n",
    "        url = \"https://data.cdc.gov/resource/swc5-untb.json\"\n",
    "        \n",
    "        # Get measures for 2000 or closest available year\n",
    "        # Focus on health outcomes relevant to elderly\n",
    "        params = {\n",
    "            '$where': 'year = 2000',\n",
    "            '$select': 'locationid,measure,data_value',\n",
    "            '$limit': 50000\n",
    "        }\n",
    "        \n",
    "        try:\n",
    "            response = requests.get(url, params=params)\n",
    "            if response.status_code == 200:\n",
    "                data = response.json()\n",
    "                df = pd.DataFrame(data)\n",
    "                \n",
    "                # Pivot to get measures as columns\n",
    "                pivot_df = df.pivot(index='locationid', \n",
    "                                  columns='measure', \n",
    "                                  values='data_value')\n",
    "                \n",
    "                # Select relevant measures if available\n",
    "                health_cols = [col for col in pivot_df.columns \n",
    "                             if any(term in col.lower() for term in \n",
    "                                   ['diabetes', 'heart', 'obesity', 'physical'])]\n",
    "                \n",
    "                result_df = pivot_df[health_cols].reset_index()\n",
    "                result_df.rename(columns={'locationid': 'fips'}, inplace=True)\n",
    "                \n",
    "                return result_df\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error fetching CDC data: {e}\")\n",
    "        \n",
    "        return None\n",
    "    \n",
    "    def get_usda_rural_urban_codes(self):\n",
    "        \"\"\"\n",
    "        Get Rural-Urban Continuum Codes from USDA ERS\n",
    "        These classify counties by urbanization level\n",
    "        \"\"\"\n",
    "        print(\"Fetching USDA Rural-Urban Continuum Codes...\")\n",
    "        \n",
    "        # Direct file download from USDA ERS\n",
    "        url = \"https://www.ers.usda.gov/webdocs/DataFiles/53251/ruralurbancodes2003.xls\"\n",
    "        \n",
    "        try:\n",
    "            # Read Excel file directly from URL\n",
    "            df = pd.read_excel(url, dtype={'FIPS': str})\n",
    "            df['fips'] = df['FIPS'].str.zfill(5)\n",
    "            \n",
    "            # Create dummy variables for different urbanization levels\n",
    "            df['is_large_metro'] = (df['RUCC_2003'] <= 3).astype(int)\n",
    "            df['is_small_metro'] = ((df['RUCC_2003'] >= 4) & (df['RUCC_2003'] <= 6)).astype(int)\n",
    "            df['is_rural'] = (df['RUCC_2003'] >= 7).astype(int)\n",
    "            df['rucc_code'] = df['RUCC_2003']\n",
    "            \n",
    "            return df[['fips', 'rucc_code', 'is_large_metro', 'is_small_metro', 'is_rural']]\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error fetching USDA RUCC data: {e}\")\n",
    "        \n",
    "        return None\n",
    "    \n",
    "    def get_noaa_climate_normals(self):\n",
    "        \"\"\"\n",
    "        Get climate normals from NOAA\n",
    "        This requires county centroids and is complex - simplified version\n",
    "        \"\"\"\n",
    "        print(\"Getting climate data from NOAA...\")\n",
    "        \n",
    "        # NOAA Climate Data API\n",
    "        # You need to:\n",
    "        # 1. Get county centroids\n",
    "        # 2. Find nearest weather stations\n",
    "        # 3. Aggregate station data to county level\n",
    "        \n",
    "        # For demonstration, create synthetic climate variables\n",
    "        # based on latitude (simplified approach)\n",
    "        \n",
    "        # This would require significant processing\n",
    "        # Return None for now\n",
    "        return None\n",
    "    \n",
    "    def get_social_capital_index(self):\n",
    "        \"\"\"\n",
    "        Get Social Capital Index from Penn State\n",
    "        This measures community cohesion and civic engagement\n",
    "        \"\"\"\n",
    "        print(\"Fetching Social Capital Index...\")\n",
    "        \n",
    "        # This dataset is often distributed as a file\n",
    "        # Check: https://aese.psu.edu/nercrd/community/social-capital-resources\n",
    "        \n",
    "        try:\n",
    "            # If you have the URL to the data file:\n",
    "            # url = \"SOCIAL_CAPITAL_DATA_URL\"\n",
    "            # df = pd.read_csv(url)\n",
    "            # return df[['fips', 'social_capital_index']]\n",
    "            \n",
    "            # For now, return None\n",
    "            return None\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error fetching social capital data: {e}\")\n",
    "            return None\n",
    "    \n",
    "    def create_metro_adjacency_features(self):\n",
    "        \"\"\"\n",
    "        Create features based on proximity to metro areas\n",
    "        Uses USDA Metro/Non-metro adjacency file\n",
    "        \"\"\"\n",
    "        print(\"Creating metro adjacency features...\")\n",
    "        \n",
    "        try:\n",
    "            # USDA provides county adjacency files\n",
    "            url = \"https://www.ers.usda.gov/webdocs/DataFiles/53241/County_Adjacency.xlsx\"\n",
    "            \n",
    "            # This would need processing to create:\n",
    "            # - Adjacent to metro area (binary)\n",
    "            # - Number of adjacent metro counties\n",
    "            # - Distance to nearest metro area\n",
    "            \n",
    "            # Placeholder for now\n",
    "            return None\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error creating adjacency features: {e}\")\n",
    "            return None\n",
    "\n",
    "def integrate_additional_data(base_df):\n",
    "    \"\"\"\n",
    "    Integrate all additional data sources with the base dataframe\n",
    "    \"\"\"\n",
    "    collector = AdditionalDataCollector()\n",
    "    \n",
    "    # Get USDA Rural-Urban codes (this one usually works)\n",
    "    rucc_df = collector.get_usda_rural_urban_codes()\n",
    "    if rucc_df is not None:\n",
    "        base_df = pd.merge(base_df, rucc_df, on='fips', how='left')\n",
    "        print(f\"Added Rural-Urban Continuum Codes: {base_df['rucc_code'].notna().sum()} counties\")\n",
    "    \n",
    "    # Get other data sources as available\n",
    "    # Each of these may require API keys or have availability issues\n",
    "    \n",
    "    # Create polynomial features for non-linear relationships\n",
    "    if 'rucc_code' in base_df.columns:\n",
    "        base_df['urbanization_sq'] = base_df['rucc_code'] ** 2\n",
    "    \n",
    "    # Create more sophisticated interaction terms\n",
    "    if all(col in base_df.columns for col in ['is_rural', 'healthcare_share_2000']):\n",
    "        base_df['rural_x_healthcare'] = base_df['is_rural'] * base_df['healthcare_share_2000']\n",
    "    \n",
    "    if all(col in base_df.columns for col in ['is_large_metro', 'median_house_value_2000']):\n",
    "        base_df['metro_x_house_value'] = base_df['is_large_metro'] * base_df['median_house_value_2000']\n",
    "    \n",
    "    return base_df\n",
    "\n",
    "# Additional feature engineering functions\n",
    "def create_spatial_lag_features(df):\n",
    "    \"\"\"\n",
    "    Create spatial lag features (requires county adjacency matrix)\n",
    "    These capture spillover effects from neighboring counties\n",
    "    \"\"\"\n",
    "    print(\"Creating spatial lag features...\")\n",
    "    \n",
    "    # This would require:\n",
    "    # 1. County adjacency matrix\n",
    "    # 2. Calculate weighted averages of neighbor values\n",
    "    \n",
    "    # Placeholder features that could be created:\n",
    "    # - Average 65+ share in adjacent counties\n",
    "    # - Average income in adjacent counties\n",
    "    # - Average amenity scale in adjacent counties\n",
    "    \n",
    "    return df\n",
    "\n",
    "def create_demographic_diversity_index(df):\n",
    "    \"\"\"\n",
    "    Create a demographic diversity index\n",
    "    Could help capture areas attractive to retirees\n",
    "    \"\"\"\n",
    "    if all(col in df.columns for col in ['pct_65plus_2000', 'pct_ba_plus_2000']):\n",
    "        # Simple diversity measure\n",
    "        df['demographic_diversity'] = (\n",
    "            df['pct_65plus_2000'].rank(pct=True) * \n",
    "            df['pct_ba_plus_2000'].rank(pct=True)\n",
    "        )\n",
    "    \n",
    "    return df\n",
    "\n",
    "def create_retirement_attractiveness_index(df):\n",
    "    \"\"\"\n",
    "    Create composite index of retirement attractiveness\n",
    "    \"\"\"\n",
    "    retirement_factors = []\n",
    "    \n",
    "    # Add factors as available\n",
    "    if 'Scale' in df.columns:\n",
    "        retirement_factors.append(df['Scale'].rank(pct=True))\n",
    "    \n",
    "    if 'healthcare_share_2000' in df.columns:\n",
    "        retirement_factors.append(df['healthcare_share_2000'].rank(pct=True))\n",
    "    \n",
    "    if 'median_house_value_2000' in df.columns:\n",
    "        # Inverse rank - lower house values might be more attractive\n",
    "        retirement_factors.append(1 - df['median_house_value_2000'].rank(pct=True))\n",
    "    \n",
    "    if 'crime_rate' in df.columns:\n",
    "        # If we had crime data - lower is better\n",
    "        retirement_factors.append(1 - df['crime_rate'].rank(pct=True))\n",
    "    \n",
    "    if retirement_factors:\n",
    "        df['retirement_attractiveness'] = np.mean(retirement_factors, axis=0)\n",
    "    \n",
    "    return df"
   ]
  },
